    "# Cell 3: FastAPI server - OpenAI-compatible /v1/chat/completions + vision + editable system prompt\n",
    "from fastapi import FastAPI\n",
    "from pydantic import BaseModel\n",
    "from typing import List, Union\n",
    "import io, base64\n",
    "import uvicorn\n",
    "from PIL import Image\n",
    "\n",
    "app = FastAPI()\n",
    "import time\n",
    "SERVER_START = time.time()\n",
    "\n",
    "SYSTEM_PROMPT = (\n",
    "    \"You are a computer-use assistant. You see the user's screen and control their PC.\\n\\n\"\n",
    "    \"Rules:\\n\"\n",
    "    \"- Prefer keyboard over mouse clicks whenever possible (typing, shortcuts, URLs).\\n\"\n",
    "    \"- Use clicks only when there is no keyboard way to do the task.\\n\"\n",
    "    \"- Confirm before any destructive action (delete, format, uninstall, shutdown).\\n\"\n",
    "    \"- Reply with one clear action at a time: what to type or where to click.\\n\"\n",
    "    \"- If a click misses, say so and suggest the keyboard alternative.\\n\"\n",
    "    \"- Keep answers short. No explanations unless asked.\\n\"\n",
    ")\n",
    "\n",
    "class Message(BaseModel):\n",
    "    role: str\n",
    "    # Plain string, OR OpenAI vision parts:\n",
    "    # [{\"type\":\"text\",\"text\":\"...\"}, {\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,...\"}}]\n",
    "    content: Union[str, list]\n",
    "\n",
    "class ChatRequest(BaseModel):\n",
    "    model: str = MODEL_ID\n",
    "    messages: List[Message]\n",
    "    max_tokens: int = 512\n",
    "    temperature: float = 0.2\n",
    "\n",
    "class PromptUpdate(BaseModel):\n",
    "    prompt: str\n",
    "\n",
    "def to_vl_message(m):\n",
    "    \"\"\"Convert one chat message to the Qwen/UI-TARS vision-language format.\"\"\"\n",
    "    if isinstance(m.content, str):\n",
    "        return {\"role\": m.role, \"content\": m.content}\n",
    "    parts = []\n",
    "    for p in m.content:\n",
    "        if not isinstance(p, dict):\n",
    "            continue\n",
    "        t = p.get(\"type\")\n",
    "        if t == \"text\":\n",
    "            parts.append({\"type\": \"text\", \"text\": p.get(\"text\", \"\")})\n",
    "        elif t == \"image_url\":\n",
    "            u = p.get(\"image_url\", {})\n",
    "            u = u.get(\"url\", u) if isinstance(u, dict) else u\n",
    "            if isinstance(u, str) and u.startswith(\"data:\"):\n",
    "                u = Image.open(io.BytesIO(base64.b64decode(u.split(\",\", 1)[1])))\n",
    "            parts.append({\"type\": \"image\", \"image\": u})\n",
    "    return {\"role\": m.role, \"content\": parts}\n",
    "\n",
    "@app.post(\"/v1/chat/completions\")\n",
    "def chat(req: ChatRequest):\n",
    "    msgs = [Message(role=\"system\", content=SYSTEM_PROMPT)] + req.messages\n",
